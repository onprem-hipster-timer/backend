# ============================================================
# 환경 변수 설정 예시
# 이 파일을 .env로 복사하여 사용하세요
# ============================================================

# ============================================================
# 애플리케이션 설정
# ============================================================
APP_NAME=onperm-hipster-timer-backend
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ============================================================
# 데이터베이스 설정
# ============================================================

# SQLite (기본값 - 개발/테스트용)
DATABASE_URL=sqlite:///./schedule.db

# PostgreSQL (프로덕션 권장)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# 커넥션 풀 설정 (PostgreSQL 등 외부 DB용)
POOL_SIZE=5
MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# DB Keep-Alive
# 유휴 시 DB가 자동 정지되거나 연결이 끊기는 것을 막기 위해
# 주기적으로 가벼운 쿼리(SELECT 1)를 실행합니다.
# (예: 일정 시간 트래픽이 없으면 인스턴스를 정지시키는 무료 호스팅 DB의 유휴 정지 방지)
# 값(초)이 0 이하이면 비활성화됩니다. 예: 300 = 5분마다 ping
DB_KEEPALIVE_INTERVAL_SECONDS=0

# ============================================================
# OIDC 인증 설정
# ============================================================
# Kratos 세션 토크나이저가 발급한 JWT를 검증한다. iss는 Kratos public base_url(끝 슬래시 포함)
OIDC_ENABLED=true
OIDC_ISSUER_URL=https://api.example.com/auth/
OIDC_AUDIENCE=https://api.example.com
# 공개 JWKS JSON. 설정하면 discovery 대신 이 키로 검증한다 (Kratos는 discovery 엔드포인트가 없음)
# OIDC_JWKS='{"keys":[{"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"..."}]}'
# OIDC_DISCOVERY_URL=  # OIDC_JWKS가 없을 때만 사용. 기본: OIDC_ISSUER_URL/.well-known/openid-configuration
OIDC_JWKS_CACHE_TTL_SECONDS=3600

# Kratos 공개 API (사이드카). /auth/*를 이 주소로 프록시한다. 비우면 /auth/*는 404
# KRATOS_PUBLIC_URL=http://127.0.0.1:4433
# Kratos admin API (사이드카). 회원 탈퇴 때 세션 폐기·identity 삭제에 쓴다. 비우면 호출하지 않는다
# KRATOS_ADMIN_URL=http://127.0.0.1:4434
# 회원 탈퇴 유예 기간(일)과 파기 엔드포인트(POST /internal/accounts/purge)의 X-Purge-Token 값. 토큰이 비면 404
# ACCOUNT_DELETION_GRACE_DAYS=3
# ACCOUNT_PURGE_TOKEN=
# 메일을 보내는 Kratos courier Cloud Run 잡 (전체 리소스 이름). KRATOS_COURIER_JOB이 비면 실행하지 않는다
# COURIER_REQUEUE_JOB=projects/<project>/locations/<region>/jobs/courier-requeue
# KRATOS_COURIER_JOB=projects/<project>/locations/<region>/jobs/kratos-courier

# ============================================================
# Rate Limit 설정
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_DEFAULT_REQUESTS=60

# ============================================================
# GraphQL 설정
# ============================================================
GRAPHQL_ENABLE_PLAYGROUND=true
GRAPHQL_ENABLE_INTROSPECTION=true

# ============================================================
# 외부 API 설정
# ============================================================
HOLIDAY_API_BASE_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService
HOLIDAY_API_SERVICE_KEY=your-service-key
