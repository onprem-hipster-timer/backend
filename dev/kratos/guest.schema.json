{
  "$id": "https://kratos.invalid/identity.guest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guest",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "title": "Handle",
          "format": "email",
          "maxLength": 64,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "verification": {
              "via": "email"
            }
          }
        },
        "name": {
          "type": "string",
          "title": "Name",
          "minLength": 1,
          "maxLength": 50
        }
      },
      "required": [
        "handle",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
